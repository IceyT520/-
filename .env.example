# DeepSeek API 密钥, 从 https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=sk-在这里填入你的密钥

# 以下为可选项(公网/局域网部署时使用, 本地自用不用填):
# HSSE_ACCESS_PASSWORD=   设置后访问网页需要登录(用户名默认 hsse)
# HSSE_ACCESS_USER=hsse   自定义访问用户名
# HSSE_UPLOAD_PASSWORD=   设置后上传文献需要单独口令
# HSSE_SHARE_LAN=1        允许局域网/公网访问(默认仅本机)
# HSSE_PORT=7860          网页端口
